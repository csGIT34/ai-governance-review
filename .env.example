# Copy to .env (git-ignored); docker compose reads it.
# Evidence repo, for SHA-pinning checks on evidence links
EVIDENCE_REPO_BASE=https://github.example.com/org/audit-evidence
# Scope sync from Azure (service principal locally; managed identity on Azure)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# AZURE_ROOT_MANAGEMENT_GROUP=   # defaults to the tenant root group
# AI review catalog enrichment (optional)
AZURE_SUBSCRIPTION_ID=
GOOGLE_CLOUD_PROJECT=
